# =============================================================================
#  .gitignore —— CH572 固化协议栈工程
#
#  原则：
#    1. 只排除「构建产生」和「工具缓存」，源文件/厂商库/文档一律保留。
#    2. 厂商文件（WCH 原样提供的 .a / .h / .c / .S）必须进仓库 —— 没有它们
#       别人（包括未来的你）拿到这个仓库是跑不起来的，它们不是可再生的。
#    3. 自己不生成、但**可选**的产物（ROM 生成物）见文件末尾的说明段。
#
#  判断某个文件该不该排除的方法：
#    把这个文件删掉，跑一遍 build.ps1 -Target all，它能自己回来 → 应该排除。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、构建输出（脚本每次都会重建，删掉无损失）
# -----------------------------------------------------------------------------
# build/ 整个排除。历史上这里曾放过一份"修复前快照" build/pre_fix_backup/，
# 并用 ! 反排除保住它；该快照已按需删除，规则一并去掉。
#
# 若以后又要往 build/ 里放需要进仓库的东西，反排除规则必须写在 build/** **之后**：
# Git 是"后匹配覆盖先匹配"，顺序写反会让文件被静默排除（这个坑踩过，
# 25 个文件差点无声丢掉）。
build/**
.build/


# -----------------------------------------------------------------------------
# 二、ROM 镜像构建产物（make_rom.ps1 生成）
#
#   这些全部由 make_rom.ps1 重新生成，且生成是确定性的（同样输入 → 同样输出）。
#   删掉后跑一次 make_rom.ps1 即可恢复。
# -----------------------------------------------------------------------------
lib/CH572BLE_ROM.bin
lib/CH572BLE_ROM.hex
lib/CH572BLE_ROM.map
lib/CH572BLE_ROM_SYMS.txt
lib/CH572BLE_ROM_JT.md

include/CH572BLE_ROM.h
include/CH572BLE_ROM_types.h

rom/rom_ram_info.h
rom/rom_ram_info.ld
rom/rom_version.h
rom/rom_stub.c


# -----------------------------------------------------------------------------
# 三、静态库构建产物
#
#   libCH572BLE.a 是 build.ps1 -Target lib 把 src/StdPeriphDriver + hal/ +
#   debug/ 编出来的，可重建，不进仓库。
#
#   ★ 反例（必须保留）：★
#     lib/libCH572BLE_PERI.a  WCH 官方 BLE 协议栈库，本项目一切的前提
#     lib/libISP572.a         WCH 官方 ISP 库
#   这两个是外部输入，删了就只能重新下载 EVT 包，不要排除。
# -----------------------------------------------------------------------------
lib/libCH572BLE.a
lib/*.lib


# -----------------------------------------------------------------------------
# 四、Python 缓存
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/


# -----------------------------------------------------------------------------
# 五、编辑器 / IDE 临时文件
#
#   注意：examples/ble_uart/.project 与 .cproject **不在**这里 ——
#   它们是 make_mrs_project.ps1 生成的 MounRiver Studio 工程，虽然能重新生成，
#   但生成时要指定 CH572EVT SDK 路径，留着开箱即用，所以进仓库。
#   .template 是 MRS 自己的空标记文件，同理保留。
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
*.tmp
*.autosave

# MRS 每次打开工程会刷新的本地索引
.settings/


# -----------------------------------------------------------------------------
# 六、操作系统垃圾
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# 七、排查时手工放的临时文件（别忘了删）
#
#   注意 *.log 是**全局**排除的：构建日志本来就在 build/logs/ 下（已被 build/**
#   排除），这里再排一次是为了兜住排查时导到根目录或 docs/ 下的日志。
#   本项目没有任何 .log 是源码，所以不会误伤。
# -----------------------------------------------------------------------------
*.log
*.dump
*.core
*.stackdump


# =============================================================================
#  可选：想让仓库更"干净"的话，把下面几段取消注释
#
#  这些文件是「生成物但被当源码引用」—— 应用编译时会 #include 它们，
#  所以**提交它们的好处是 fresh clone 能直接构建应用**。取消注释后，
#  clone 下来必须先跑 make_rom.ps1 才能编应用。
# =============================================================================

# --- 选项 A：连 ROM 生成物一起不提交（clone 后必须先 make_rom.ps1）---
# include/CH572BLE_ROM.h
# include/CH572BLE_ROM_types.h
# rom/rom_ram_info.h
# rom/rom_ram_info.ld
# rom/rom_version.h
# rom/rom_stub.c
# lib/CH572BLE_ROM.hex
# lib/CH572BLE_ROM.bin

# --- 选项 B：连厂商库也不提交（仓库会小 ~1.2 MB，但跑不起来）---
# lib/libCH572BLE_PERI.a
# lib/libISP572.a

# --- 选项 C：MRS 工程文件也不提交 ---
# examples/*/.project
# examples/*/.cproject
# examples/*/.template
